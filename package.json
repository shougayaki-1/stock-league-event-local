{
  "name": "stock-league-event-local",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f firebase runner web",
    "ai:mcp": "node tools/ai-context-server.mjs",
    "test:unit": "vitest run functions/src src",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run test/rules\"",
    "test:functions": "cd functions && npm run build && cd .. && firebase emulators:exec --only firestore,auth \"vitest run functions/test --no-file-parallelism\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:functions"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tailwindcss/vite": "^4.2.4",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.11.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "react-player": "^3.4.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.2.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
